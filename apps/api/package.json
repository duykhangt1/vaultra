{
  "name": "@vaultra/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node prisma/tools/migrate.cjs",
    "db:reset": "node prisma/tools/migrate.cjs --reset",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:e2e": "tsx test/e2e/run-all.ts",
    "test:audit": "tsx --test test/audit/audit.unit.ts",
    "prisma:generate": "prisma generate",
    "db:sql": "node prisma/tools/generate-ddl.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.740.0",
    "@aws-sdk/s3-request-presigner": "^3.740.0",
    "@google/genai": "^1.0.0",
    "@nestjs/common": "^11.0.7",
    "@nestjs/core": "^11.0.7",
    "@nestjs/platform-express": "~11.2.8",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vaultra/shared": "workspace:*",
    "alasql": "^4.22.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.5.0",
    "dejavu-fonts-ttf": "2.37.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "mariadb": "3.5.5",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/prisma-schema-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.2",
    "prisma": "7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
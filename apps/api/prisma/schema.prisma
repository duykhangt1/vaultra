// Vaultra — Self-Storage Facility Rental and Management System
// Prisma is the schema source (spec §10). Things Prisma cannot express are declared with
// triple-slash annotations consumed by prisma/tools/generate-ddl.cjs:
//   /// generated: <SQL expr>          -> GENERATED ALWAYS AS (expr) STORED  (field must be optional)
//   /// fk: <table>.<col> <ACTION>      -> FOREIGN KEY without a Prisma relation
//   /// check: <SQL expr>               -> CHECK constraint (model level)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============================================================================
// Group 1 — Accounts, authentication, authorization
// ============================================================================

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum Locale {
  vi
  en
}

model User {
  id                 BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  public_id          String     @unique @db.Char(26)
  email              String     @unique @db.VarChar(254)
  email_verified_at  DateTime?  @db.DateTime(3)
  password_hash      String?    @db.VarChar(255)
  full_name          String     @db.VarChar(150)
  phone              String?    @db.VarChar(20)
  /// fk: media_files.id SET NULL
  avatar_media_id    BigInt?    @db.UnsignedBigInt
  status             UserStatus @default(ACTIVE)
  locked_until       DateTime?  @db.DateTime(3)
  failed_login_count Int        @default(0) @db.UnsignedSmallInt
  lock_level         Int        @default(0) @db.UnsignedTinyInt
  locale             Locale     @default(vi)
  mfa_enabled        Boolean    @default(false)
  mfa_secret_enc     Bytes?     @db.VarBinary(256)
  password_changed_at DateTime? @db.DateTime(3)
  last_login_at      DateTime?  @db.DateTime(3)
  token_version      Int        @default(0) @db.UnsignedInt
  created_at         DateTime   @default(now()) @db.DateTime(3)
  updated_at         DateTime   @updatedAt @db.DateTime(3)
  deleted_at         DateTime?  @db.DateTime(3)

  customer      Customer?
  roles         UserRole[]       @relation("UserRoleUser")
  oauth         OAuthAccount[]
  sessions      UserSession[]
  auth_tokens   AuthToken[]
  consents      UserConsent[]
  notifications Notification[]
  tasks         WorkTask[]       @relation("TaskAssignee")
  shifts        StaffShift[]     @relation("ShiftUser")
  tickets_assigned SupportTicket[] @relation("TicketAssignee")

  @@index([status])
  @@index([phone])
  @@map("users")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum IdDocumentType {
  CCCD
  PASSPORT
  OTHER
}

model Customer {
  id                       BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  public_id                String          @unique @db.Char(26)
  code                     String          @unique @db.VarChar(32)
  user_id                  BigInt?         @unique @db.UnsignedBigInt
  type                     CustomerType    @default(INDIVIDUAL)
  full_name                String          @db.VarChar(150)
  email                    String?         @db.VarChar(254)
  phone                    String?         @db.VarChar(20)
  date_of_birth            DateTime?       @db.Date
  address_line             String?         @db.VarChar(255)
  ward                     String?         @db.VarChar(100)
  district                 String?         @db.VarChar(100)
  province                 String?         @db.VarChar(100)
  id_document_type         IdDocumentType?
  id_document_last4        String?         @db.Char(4)
  id_document_number_enc   Bytes?          @db.VarBinary(256)
  company_name             String?         @db.VarChar(200)
  tax_code                 String?         @db.VarChar(20)
  emergency_contact_name   String?         @db.VarChar(150)
  emergency_contact_phone  String?         @db.VarChar(20)
  booking_blocked          Boolean         @default(false)
  booking_blocked_reason   String?         @db.VarChar(255)
  balance_cached           Decimal         @default(0) @db.Decimal(15, 2)
  marketing_opt_in         Boolean         @default(false)
  email_suppressed         Boolean         @default(false)
  /// fk: users.id SET NULL
  created_by               BigInt?         @db.UnsignedBigInt
  created_at               DateTime        @default(now()) @db.DateTime(3)
  updated_at               DateTime        @updatedAt @db.DateTime(3)
  deleted_at               DateTime?       @db.DateTime(3)

  user         User?          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  reservations Reservation[]
  contracts    Contract[]
  invoices     Invoice[]
  payments     Payment[]
  tickets      SupportTicket[]
  appointments Appointment[]
  ledger       CustomerLedgerEntry[]

  @@index([phone])
  @@index([email])
  @@fulltext([full_name, email, phone])
  @@map("customers")
}

enum RoleCode {
  CUSTOMER
  FACILITY_STAFF
  FACILITY_MANAGER
  BUSINESS_OPS_MANAGER
  SYSTEM_ADMIN
}

model Role {
  id                 Int              @id @db.UnsignedTinyInt
  code               RoleCode         @unique
  name               String           @db.VarChar(100)
  description        String?          @db.VarChar(255)
  is_facility_scoped Boolean          @default(false)
  permissions        RolePermission[]
  users              UserRole[]

  @@map("roles")
}

model Permission {
  id          Int              @id @db.UnsignedSmallInt
  code        String           @unique @db.VarChar(64)
  module      String           @db.VarChar(40)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

enum PermissionScope {
  OWN
  FACILITY
  GLOBAL
}

model RolePermission {
  role_id       Int             @db.UnsignedTinyInt
  permission_id Int             @db.UnsignedSmallInt
  scope         PermissionScope
  read_only     Boolean         @default(false)
  role          Role            @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission      @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  role_id      Int       @db.UnsignedTinyInt
  facility_id  BigInt?   @db.UnsignedBigInt
  /// generated: COALESCE(`facility_id`, 0)
  facility_key BigInt?   @db.UnsignedBigInt
  /// fk: users.id SET NULL
  assigned_by  BigInt?   @db.UnsignedBigInt
  assigned_at  DateTime  @default(now()) @db.DateTime(3)
  revoked_at   DateTime? @db.DateTime(3)
  /// fk: users.id SET NULL
  revoked_by   BigInt?   @db.UnsignedBigInt
  /// generated: IF(`revoked_at` IS NULL, 1, NULL)
  active_key   Int?      @db.TinyInt

  user     User      @relation("UserRoleUser", fields: [user_id], references: [id], onDelete: Restrict)
  role     Role      @relation(fields: [role_id], references: [id], onDelete: Restrict)
  facility Facility? @relation(fields: [facility_id], references: [id], onDelete: Restrict)

  @@unique([user_id, role_id, facility_key, active_key])
  @@index([facility_id, role_id])
  @@map("user_roles")
}

enum OAuthProvider {
  GOOGLE
}

model OAuthAccount {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  user_id          BigInt        @db.UnsignedBigInt
  provider         OAuthProvider
  provider_subject String        @db.VarChar(255)
  email_at_link    String?       @db.VarChar(254)
  linked_at        DateTime      @default(now()) @db.DateTime(3)
  last_used_at     DateTime?     @db.DateTime(3)
  user             User          @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([provider, provider_subject])
  @@unique([user_id, provider])
  @@map("oauth_accounts")
}

enum AuthMethod {
  PASSWORD
  GOOGLE
  INVITE
  PASSWORD_RESET
}

enum SessionRevokeReason {
  LOGOUT
  ADMIN
  PASSWORD_CHANGED
  TOKEN_REUSE
  ROLE_CHANGED
  EXPIRED
}

model UserSession {
  id             BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  public_id      String               @unique @db.Char(26)
  user_id        BigInt               @db.UnsignedBigInt
  auth_method    AuthMethod
  ip_address     String?              @db.VarChar(45)
  user_agent     String?              @db.VarChar(512)
  device_label   String?              @db.VarChar(100)
  country        String?              @db.Char(2)
  created_at     DateTime             @default(now()) @db.DateTime(3)
  last_seen_at   DateTime             @default(now()) @db.DateTime(3)
  expires_at     DateTime             @db.DateTime(3)
  revoked_at     DateTime?            @db.DateTime(3)
  revoked_reason SessionRevokeReason?
  user           User                 @relation(fields: [user_id], references: [id], onDelete: Restrict)
  refresh_tokens RefreshToken[]

  @@index([user_id, revoked_at])
  @@map("user_sessions")
}

model RefreshToken {
  id         BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  session_id BigInt         @db.UnsignedBigInt
  token_hash String         @unique @db.Char(64)
  parent_id  BigInt?        @db.UnsignedBigInt
  issued_at  DateTime       @default(now()) @db.DateTime(3)
  expires_at DateTime       @db.DateTime(3)
  used_at    DateTime?      @db.DateTime(3)
  revoked_at DateTime?      @db.DateTime(3)
  session    UserSession    @relation(fields: [session_id], references: [id], onDelete: Cascade)
  parent     RefreshToken?  @relation("TokenChain", fields: [parent_id], references: [id], onDelete: SetNull)
  children   RefreshToken[] @relation("TokenChain")

  @@index([session_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
  EMAIL_CHANGE
  ACCOUNT_LINK
  SIGN_OTP
}

model AuthToken {
  id         BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt           @db.UnsignedBigInt
  purpose    AuthTokenPurpose
  token_hash String           @unique @db.Char(64)
  payload    Json?
  expires_at DateTime         @db.DateTime(3)
  used_at    DateTime?        @db.DateTime(3)
  created_ip String?          @db.VarChar(45)
  created_at DateTime         @default(now()) @db.DateTime(3)
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@map("auth_tokens")
}

enum LoginMethod {
  PASSWORD
  GOOGLE
  REFRESH
}

enum LoginFailure {
  BAD_CREDENTIALS
  LOCKED
  DISABLED
  UNVERIFIED
  MFA_FAILED
  OAUTH_ERROR
  RATE_LIMITED
  TOKEN_REUSE
}

model LoginHistory {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  /// fk: users.id SET NULL
  user_id         BigInt?       @db.UnsignedBigInt
  email_attempted String?       @db.VarChar(254)
  method          LoginMethod
  success         Boolean
  failure_reason  LoginFailure?
  ip_address      String?       @db.VarChar(45)
  user_agent      String?       @db.VarChar(512)
  country         String?       @db.Char(2)
  /// fk: user_sessions.id SET NULL
  session_id      BigInt?       @db.UnsignedBigInt
  created_at      DateTime      @default(now()) @db.DateTime(3)

  @@index([user_id, created_at])
  @@index([ip_address, created_at])
  @@index([created_at])
  @@map("login_history")
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

model UserConsent {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt      @db.UnsignedBigInt
  type         ConsentType
  version      String      @db.VarChar(20)
  accepted_at  DateTime    @default(now()) @db.DateTime(3)
  ip_address   String?     @db.VarChar(45)
  withdrawn_at DateTime?   @db.DateTime(3)
  user         User        @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@map("user_consents")
}

model Sequence {
  name       String @db.VarChar(32)
  year       Int    @db.UnsignedSmallInt
  next_value Int    @default(0) @db.UnsignedInt

  @@id([name, year])
  @@map("sequences")
}

model IpBlock {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  cidr       String    @unique @db.VarChar(64)
  reason     String?   @db.VarChar(255)
  expires_at DateTime? @db.DateTime(3)
  /// fk: users.id SET NULL
  created_by BigInt?   @db.UnsignedBigInt
  created_at DateTime  @default(now()) @db.DateTime(3)

  @@map("ip_blocks")
}

// ============================================================================
// Group 2 — Facilities, unit types, units
// ============================================================================

enum FacilityStatus {
  DRAFT
  ACTIVE
  TEMPORARILY_CLOSED
  INACTIVE
}

model Facility {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  public_id        String         @unique @db.Char(26)
  code             String         @unique @db.VarChar(16)
  name             String         @db.VarChar(150)
  slug             String         @unique @db.VarChar(160)
  status           FacilityStatus @default(DRAFT)
  accepts_bookings Boolean        @default(true)
  address_line     String         @db.VarChar(255)
  ward             String?        @db.VarChar(100)
  district         String         @db.VarChar(100)
  province         String         @db.VarChar(100)
  province_slug    String         @db.VarChar(100)
  latitude         Decimal?       @db.Decimal(9, 6)
  longitude        Decimal?       @db.Decimal(9, 6)
  timezone         String         @default("Asia/Ho_Chi_Minh") @db.VarChar(40)
  phone            String?        @db.VarChar(20)
  email            String?        @db.VarChar(254)
  hotline          String?        @db.VarChar(20)
  office_hours     Json
  access_hours     Json
  amenities        Json
  description      String?        @db.Text
  auto_assign      Boolean        @default(true)
  auto_dispatch    Boolean        @default(false)
  total_area_m2    Decimal?       @db.Decimal(10, 2)
  opened_at        DateTime?      @db.Date
  /// fk: media_files.id SET NULL
  cover_media_id   BigInt?        @db.UnsignedBigInt
  created_at       DateTime       @default(now()) @db.DateTime(3)
  updated_at       DateTime       @updatedAt @db.DateTime(3)
  deleted_at       DateTime?      @db.DateTime(3)

  zones        Zone[]
  unit_types   UnitType[]
  units        Unit[]
  user_roles   UserRole[]
  notices      FacilityNotice[]
  reservations Reservation[]
  contracts    Contract[]
  invoices     Invoice[]
  tickets      SupportTicket[]
  tasks        WorkTask[]
  shifts       StaffShift[]
  work_orders  WorkOrder[]
  appointments Appointment[]
  slots        AppointmentSlot[]
  closures     FacilityClosure[]

  @@index([province, district])
  @@index([status])
  @@map("facilities")
}

enum NoticeSeverity {
  INFO
  WARNING
  CRITICAL
}

model FacilityNotice {
  id          BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  facility_id BigInt         @db.UnsignedBigInt
  title       String         @db.VarChar(200)
  body        String         @db.Text
  severity    NoticeSeverity @default(INFO)
  starts_at   DateTime       @db.DateTime(3)
  ends_at     DateTime?      @db.DateTime(3)
  /// fk: users.id SET NULL
  created_by  BigInt?        @db.UnsignedBigInt
  created_at  DateTime       @default(now()) @db.DateTime(3)
  facility    Facility       @relation(fields: [facility_id], references: [id], onDelete: Restrict)

  @@index([facility_id, starts_at])
  @@map("facility_notices")
}

model Zone {
  id                 BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  facility_id        BigInt     @db.UnsignedBigInt
  code               String     @db.VarChar(16)
  name               String     @db.VarChar(100)
  floor              Int        @default(1) @db.TinyInt
  has_elevator       Boolean    @default(false)
  drive_up           Boolean    @default(false)
  climate_controlled Boolean    @default(false)
  sort_order         Int        @default(0) @db.SmallInt
  status             String     @default("ACTIVE") @db.VarChar(16)
  facility           Facility   @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  units              Unit[]
  floor_plan         FloorPlan?

  @@unique([facility_id, code])
  @@map("zones")
}

enum SizeCategory {
  XS
  S
  M
  L
  XL
  VEHICLE
  LOCKER
}

enum UnitTypeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// check: `width_m` > 0 AND `depth_m` > 0 AND `height_m` > 0
/// check: `online_price` <= `list_price`
model UnitType {
  id                   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  public_id            String         @unique @db.Char(26)
  facility_id          BigInt         @db.UnsignedBigInt
  code                 String         @db.VarChar(32)
  name                 String         @db.VarChar(120)
  size_category        SizeCategory
  width_m              Decimal        @db.Decimal(5, 2)
  depth_m              Decimal        @db.Decimal(5, 2)
  height_m             Decimal        @db.Decimal(5, 2)
  /// generated: (`width_m` * `depth_m`)
  area_m2              Decimal?       @db.Decimal(7, 2)
  /// generated: (`width_m` * `depth_m` * `height_m`)
  volume_m3            Decimal?       @db.Decimal(8, 2)
  climate_controlled   Boolean        @default(false)
  indoor               Boolean        @default(true)
  drive_up             Boolean        @default(false)
  power_outlet         Boolean        @default(false)
  ground_floor         Boolean        @default(false)
  fits_description     String?        @db.VarChar(255)
  description          String?        @db.Text
  list_price           Decimal        @db.Decimal(15, 2)
  online_price         Decimal        @db.Decimal(15, 2)
  deposit_override     Decimal?       @db.Decimal(15, 2)
  is_bookable          Boolean        @default(true)
  status               UnitTypeStatus @default(DRAFT)
  inspection_checklist Json?
  version              Int            @default(0) @db.UnsignedInt
  created_at           DateTime       @default(now()) @db.DateTime(3)
  updated_at           DateTime       @updatedAt @db.DateTime(3)
  deleted_at           DateTime?      @db.DateTime(3)

  facility      Facility             @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  units         Unit[]
  reservations  Reservation[]
  contracts     Contract[]
  quotes        Quote[]
  price_history PriceHistory[]
  price_requests PriceChangeRequest[]

  @@unique([facility_id, code])
  @@index([facility_id, status, is_bookable])
  @@index([size_category])
  @@index([area_m2])
  @@index([online_price])
  @@map("unit_types")
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  OVERLOCKED
  PENDING_INSPECTION
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum OperationalFlag {
  NONE
  INSPECTION_DUE
  MAINTENANCE_SCHEDULED
  ISSUE_REPORTED
}

enum DoorType {
  ROLL_UP
  SWING
  LOCKER
}

model Unit {
  id                  BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  public_id           String          @unique @db.Char(26)
  facility_id         BigInt          @db.UnsignedBigInt
  unit_type_id        BigInt          @db.UnsignedBigInt
  zone_id             BigInt          @db.UnsignedBigInt
  code                String          @db.VarChar(20)
  status              UnitStatus      @default(AVAILABLE)
  operational_flag    OperationalFlag @default(NONE)
  status_reason       String?         @db.VarChar(255)
  allocation_priority Int             @default(100) @db.SmallInt
  last_vacated_at     DateTime?       @db.DateTime(3)
  door_type           DoorType        @default(ROLL_UP)
  notes               String?         @db.VarChar(500)
  cleaned_at          DateTime?       @db.DateTime(3)
  version             Int             @default(0) @db.UnsignedInt
  created_at          DateTime        @default(now()) @db.DateTime(3)
  updated_at          DateTime        @updatedAt @db.DateTime(3)
  deleted_at          DateTime?       @db.DateTime(3)

  facility       Facility            @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  unit_type      UnitType            @relation(fields: [unit_type_id], references: [id], onDelete: Restrict)
  zone           Zone                @relation(fields: [zone_id], references: [id], onDelete: Restrict)
  allocations    UnitAllocation[]
  contracts      Contract[]
  status_history UnitStatusHistory[]
  shape          UnitShape?
  inspections    Inspection[]
  work_orders    WorkOrder[]

  @@unique([facility_id, code])
  @@index([facility_id, status])
  @@index([unit_type_id, status, allocation_priority, last_vacated_at])
  @@index([zone_id])
  @@map("units")
}

model UnitStatusHistory {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  unit_id       BigInt           @db.UnsignedBigInt
  from_status   UnitStatus?
  to_status     UnitStatus
  from_flag     OperationalFlag?
  to_flag       OperationalFlag?
  reason        String?          @db.VarChar(255)
  related_type  String?          @db.VarChar(40)
  related_id    BigInt?          @db.UnsignedBigInt
  /// fk: users.id SET NULL
  actor_user_id BigInt?          @db.UnsignedBigInt
  created_at    DateTime         @default(now()) @db.DateTime(3)
  unit          Unit             @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([unit_id, created_at])
  @@map("unit_status_history")
}

model FloorPlan {
  id                  BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  /// fk: facilities.id RESTRICT
  facility_id         BigInt      @db.UnsignedBigInt
  zone_id             BigInt      @unique @db.UnsignedBigInt
  name                String      @db.VarChar(100)
  /// fk: media_files.id SET NULL
  background_media_id BigInt?     @db.UnsignedBigInt
  width               Int         @default(40) @db.UnsignedSmallInt
  height              Int         @default(24) @db.UnsignedSmallInt
  grid_size           Int         @default(1) @db.UnsignedSmallInt
  version             Int         @default(0) @db.UnsignedInt
  published_at        DateTime?   @db.DateTime(3)
  zone                Zone        @relation(fields: [zone_id], references: [id], onDelete: Restrict)
  shapes              UnitShape[]

  @@map("floor_plans")
}

model UnitShape {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  floor_plan_id BigInt    @db.UnsignedBigInt
  unit_id       BigInt    @unique @db.UnsignedBigInt
  x             Decimal   @db.Decimal(8, 2)
  y             Decimal   @db.Decimal(8, 2)
  w             Decimal   @db.Decimal(8, 2)
  h             Decimal   @db.Decimal(8, 2)
  rotation      Int       @default(0) @db.SmallInt
  floor_plan    FloorPlan @relation(fields: [floor_plan_id], references: [id], onDelete: Cascade)
  unit          Unit      @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@map("unit_shapes")
}

enum PriceField {
  LIST_PRICE
  ONLINE_PRICE
  DEPOSIT_OVERRIDE
}

model PriceHistory {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  unit_type_id      BigInt     @db.UnsignedBigInt
  field             PriceField
  old_value         Decimal?   @db.Decimal(15, 2)
  new_value         Decimal?   @db.Decimal(15, 2)
  reason            String?    @db.VarChar(255)
  /// fk: price_change_requests.id SET NULL
  change_request_id BigInt?    @db.UnsignedBigInt
  /// fk: users.id SET NULL
  changed_by        BigInt?    @db.UnsignedBigInt
  created_at        DateTime   @default(now()) @db.DateTime(3)
  unit_type         UnitType   @relation(fields: [unit_type_id], references: [id], onDelete: Restrict)

  @@index([unit_type_id, created_at])
  @@map("price_history")
}

enum MediaBucket {
  PUBLIC
  PRIVATE
}

enum MediaPurpose {
  FACILITY_PHOTO
  UNIT_TYPE_PHOTO
  UNIT_PHOTO
  FLOOR_PLAN
  INSPECTION_PHOTO
  TICKET_ATTACHMENT
  WORK_ORDER_PHOTO
  CONTRACT_PDF
  HANDOVER_PDF
  RECEIPT_PDF
  INVOICE_PDF
  REPORT_EXPORT
  AVATAR
  SIGNATURE
  OVERLOCK_PHOTO
  ABANDONED_GOODS_PHOTO

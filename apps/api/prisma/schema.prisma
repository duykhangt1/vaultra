  SLA_BREACHED
  MERGED
  REOPENED
  LINKED_ACTION
}

model TicketEvent {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  ticket_id     BigInt          @db.UnsignedBigInt
  event         TicketEventType
  data          Json?
  /// fk: users.id SET NULL
  actor_user_id BigInt?         @db.UnsignedBigInt
  created_at    DateTime        @default(now()) @db.DateTime(3)
  ticket        SupportTicket   @relation(fields: [ticket_id], references: [id], onDelete: Restrict)

  @@index([ticket_id, created_at])
  @@map("ticket_events")
}

model SlaPolicy {
  id                     BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  /// fk: facilities.id RESTRICT
  facility_id            BigInt?        @db.UnsignedBigInt
  /// generated: COALESCE(`facility_id`, 0)
  facility_key           BigInt?        @db.UnsignedBigInt
  category               TicketCategory
  priority               Priority
  first_response_minutes Int            @db.UnsignedInt
  resolution_minutes     Int            @db.UnsignedInt
  business_hours_only    Boolean        @default(true)

  @@unique([facility_key, category, priority])
  @@map("sla_policies")
}

/// check: `score` BETWEEN 1 AND 5
model TicketRating {
  ticket_id  BigInt        @id @db.UnsignedBigInt
  score      Int           @db.UnsignedTinyInt
  comment    String?       @db.VarChar(500)
  created_at DateTime      @default(now()) @db.DateTime(3)
  ticket     SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Restrict)

  @@map("ticket_ratings")
}

// ============================================================================
// Group 6 — Notifications, logs, configuration, reports
// ============================================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model NotificationTemplate {
  id           BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  event_code   String              @db.VarChar(64)
  channel      NotificationChannel
  locale       Locale              @default(vi)
  subject      String              @db.VarChar(255)
  body         String              @db.Text
  is_mandatory Boolean             @default(false)
  active       Boolean             @default(true)
  version      Int                 @default(1) @db.UnsignedInt
  /// fk: users.id SET NULL
  updated_by   BigInt?             @db.UnsignedBigInt
  updated_at   DateTime            @updatedAt @db.DateTime(3)

  @@unique([event_code, channel, locale])
  @@map("notification_templates")
}

enum NotificationPriority {
  NORMAL
  HIGH
}

model Notification {
  id           BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  public_id    String                 @unique @db.Char(26)
  user_id      BigInt                 @db.UnsignedBigInt
  event_code   String                 @db.VarChar(64)
  title        String                 @db.VarChar(255)
  body         String                 @db.Text
  link         String?                @db.VarChar(255)
  related_type String?                @db.VarChar(40)
  related_id   BigInt?                @db.UnsignedBigInt
  priority     NotificationPriority   @default(NORMAL)
  dedupe_key   String?                @unique @db.VarChar(160)
  read_at      DateTime?              @db.DateTime(3)
  created_at   DateTime               @default(now()) @db.DateTime(3)
  user         User                   @relation(fields: [user_id], references: [id], onDelete: Restrict)
  deliveries   NotificationDelivery[]

  @@index([user_id, read_at, created_at])
  @@map("notifications")
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SUPPRESSED
}

model NotificationDelivery {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  notification_id     BigInt              @db.UnsignedBigInt
  channel             NotificationChannel
  recipient           String              @db.VarChar(254)
  subject             String?             @db.VarChar(255)
  provider_message_id String?             @db.VarChar(128)
  status              DeliveryStatus      @default(QUEUED)
  attempts            Int                 @default(0) @db.UnsignedTinyInt
  last_error          String?             @db.VarChar(500)
  next_attempt_at     DateTime?           @db.DateTime(3)
  sent_at             DateTime?           @db.DateTime(3)
  created_at          DateTime            @default(now()) @db.DateTime(3)
  notification        Notification        @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@map("notification_deliveries")
}

enum EventGroup {
  BILLING
  CONTRACT
  RENEWAL
  SUPPORT
  OPERATIONS
  MARKETING
}

model NotificationPreference {
  /// fk: users.id CASCADE
  user_id     BigInt              @db.UnsignedBigInt
  event_group EventGroup
  channel     NotificationChannel
  enabled     Boolean             @default(true)

  @@id([user_id, event_group, channel])
  @@map("notification_preferences")
}

enum AuditCategory {
  BUSINESS
  SECURITY
  CONFIG
}

model AuditLog {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  occurred_at   DateTime      @default(now()) @db.DateTime(3)
  /// fk: users.id SET NULL
  actor_user_id BigInt?       @db.UnsignedBigInt
  actor_role    String?       @db.VarChar(32)
  facility_id   BigInt?       @db.UnsignedBigInt
  action        String        @db.VarChar(64)
  entity_type   String        @db.VarChar(40)
  entity_id     BigInt?       @db.UnsignedBigInt
  entity_ref    String?       @db.VarChar(64)
  before        Json?
  after         Json?
  reason        String?       @db.VarChar(500)
  request_id    String?       @db.VarChar(64)
  ip_address    String?       @db.VarChar(45)
  user_agent    String?       @db.VarChar(512)
  category      AuditCategory @default(BUSINESS)

  @@index([occurred_at])
  @@index([entity_type, entity_id])
  @@index([actor_user_id, occurred_at])
  @@index([facility_id, occurred_at])
  @@index([category, occurred_at])
  @@map("audit_logs")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

model OutboxEvent {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  event_type     String       @db.VarChar(64)
  aggregate_type String       @db.VarChar(40)
  aggregate_id   BigInt?      @db.UnsignedBigInt
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0) @db.UnsignedTinyInt
  last_error     String?      @db.VarChar(500)
  available_at   DateTime     @default(now()) @db.DateTime(3)
  dispatched_at  DateTime?    @db.DateTime(3)
  created_at     DateTime     @default(now()) @db.DateTime(3)

  @@index([status, available_at])
  @@map("outbox_events")
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model JobRun {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  job_name        String    @db.VarChar(64)
  lock_key        String?   @unique @db.VarChar(64)
  started_at      DateTime  @default(now()) @db.DateTime(3)
  finished_at     DateTime? @db.DateTime(3)
  status          JobStatus @default(RUNNING)
  processed_count Int       @default(0) @db.UnsignedInt
  error           String?   @db.Text

  @@index([job_name, started_at])
  @@map("job_runs")
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum ExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

model ReportExport {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  public_id     String       @unique @db.Char(26)
  /// fk: users.id RESTRICT
  requested_by  BigInt       @db.UnsignedBigInt
  report_code   String       @db.VarChar(40)
  params        Json
  format        ExportFormat
  status        ExportStatus @default(QUEUED)
  /// fk: media_files.id SET NULL
  media_file_id BigInt?      @db.UnsignedBigInt
  row_count     Int?         @db.UnsignedInt
  error         String?      @db.VarChar(500)
  expires_at    DateTime?    @db.DateTime(3)
  created_at    DateTime     @default(now()) @db.DateTime(3)

  @@index([requested_by, created_at])
  @@map("report_exports")
}

model DailyFacilityMetric {
  metric_date            DateTime @db.Date
  /// fk: facilities.id RESTRICT
  facility_id            BigInt   @db.UnsignedBigInt
  unit_type_key          BigInt   @default(0) @db.UnsignedBigInt
  units_total            Int      @default(0) @db.UnsignedInt
  units_available        Int      @default(0) @db.UnsignedInt
  units_reserved         Int      @default(0) @db.UnsignedInt
  units_occupied         Int      @default(0) @db.UnsignedInt
  units_overlocked       Int      @default(0) @db.UnsignedInt
  units_unavailable      Int      @default(0) @db.UnsignedInt
  area_total_m2          Decimal  @default(0) @db.Decimal(12, 2)
  area_occupied_m2       Decimal  @default(0) @db.Decimal(12, 2)
  potential_rent         Decimal  @default(0) @db.Decimal(15, 2)
  actual_rent            Decimal  @default(0) @db.Decimal(15, 2)
  billed_amount          Decimal  @default(0) @db.Decimal(15, 2)
  collected_amount       Decimal  @default(0) @db.Decimal(15, 2)
  refunded_amount        Decimal  @default(0) @db.Decimal(15, 2)
  recognized_revenue     Decimal  @default(0) @db.Decimal(15, 2)
  ar_0_30                Decimal  @default(0) @db.Decimal(15, 2)
  ar_31_60               Decimal  @default(0) @db.Decimal(15, 2)
  ar_61_90               Decimal  @default(0) @db.Decimal(15, 2)
  ar_90_plus             Decimal  @default(0) @db.Decimal(15, 2)
  move_ins               Int      @default(0) @db.UnsignedInt
  move_outs              Int      @default(0) @db.UnsignedInt
  reservations_created   Int      @default(0) @db.UnsignedInt
  reservations_cancelled Int      @default(0) @db.UnsignedInt
  renewals_due           Int      @default(0) @db.UnsignedInt
  renewals_done          Int      @default(0) @db.UnsignedInt
  delinquent_contracts   Int      @default(0) @db.UnsignedInt
  tickets_opened         Int      @default(0) @db.UnsignedInt
  tickets_breached       Int      @default(0) @db.UnsignedInt

  @@id([metric_date, facility_id, unit_type_key])
  @@index([facility_id, metric_date])
  @@map("daily_facility_metrics")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum SettingCategory {
  SECURITY
  BRANDING
  FEATURE_FLAG
  INTEGRATION
  NOTIFICATION
  AI
}

model SystemSetting {
  key        String          @id @db.VarChar(100)
  value      Json
  value_type SettingType
  category   SettingCategory
  is_secret  Boolean         @default(false)
  description String?        @db.VarChar(255)
  /// fk: users.id SET NULL
  updated_by BigInt?         @db.UnsignedBigInt
  updated_at DateTime        @updatedAt @db.DateTime(3)
  version    Int             @default(0) @db.UnsignedInt

  @@map("system_settings")
}

// ============================================================================
// Module 25 — AI assistant (spec §22.7)
// ============================================================================

enum ConversationChannel {
  PUBLIC
  CUSTOMER
  OPS
}

enum ConversationStatus {
  OPEN
  HANDED_OFF
  CLOSED
}

model AssistantConversation {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  public_id         String              @unique @db.Char(26)
  /// fk: users.id SET NULL
  user_id           BigInt?             @db.UnsignedBigInt
  anon_session_hash String?             @db.Char(64)
  channel           ConversationChannel
  locale            Locale              @default(vi)
  status            ConversationStatus  @default(OPEN)
  /// fk: support_tickets.id SET NULL
  ticket_id         BigInt?             @db.UnsignedBigInt
  message_count     Int                 @default(0) @db.UnsignedInt
  last_message_at   DateTime?           @db.DateTime(3)
  expires_at        DateTime            @db.DateTime(3)
  created_at        DateTime            @default(now()) @db.DateTime(3)
  deleted_at        DateTime?           @db.DateTime(3)
  messages          AssistantMessage[]

  @@index([user_id, last_message_at])
  @@index([anon_session_hash])
  @@map("assistant_conversations")
}

enum AssistantRole {
  USER
  ASSISTANT
  TOOL
}

model AssistantMessage {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  public_id       String                @unique @db.Char(26)
  conversation_id BigInt                @db.UnsignedBigInt
  role            AssistantRole
  content         String                @db.Text
  cards           Json?
  model           String?               @db.VarChar(64)
  input_tokens    Int?                  @db.UnsignedInt
  output_tokens   Int?                  @db.UnsignedInt
  latency_ms      Int?                  @db.UnsignedInt
  finish_reason   String?               @db.VarChar(32)
  is_fallback     Boolean               @default(false)
  created_at      DateTime              @default(now()) @db.DateTime(3)
  conversation    AssistantConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  tool_calls      AssistantToolCall[]
  feedback        AssistantFeedback?

  @@index([conversation_id, created_at])
  @@map("assistant_messages")
}

enum ToolCallStatus {
  OK
  DENIED
  ERROR
}

model AssistantToolCall {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  message_id     BigInt           @db.UnsignedBigInt
  tool_name      String           @db.VarChar(64)
  arguments      Json
  result_summary Json?
  status         ToolCallStatus
  duration_ms    Int              @db.UnsignedInt
  message        AssistantMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@map("assistant_tool_calls")
}

enum FeedbackRating {
  UP
  DOWN
}

enum FeedbackReason {
  WRONG
  NOT_HELPFUL
  UNSAFE
  OTHER
}

model AssistantFeedback {
  message_id BigInt           @id @db.UnsignedBigInt
  rating     FeedbackRating
  reason     FeedbackReason?
  comment    String?          @db.VarChar(500)
  created_at DateTime         @default(now()) @db.DateTime(3)
  message    AssistantMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@map("assistant_feedback")
}

enum KbCategory {
  FAQ
  SIZE_GUIDE
  POLICY
  RULES
  FACILITY_INFO
  SOP
}

enum KbAudience {
  PUBLIC
  CUSTOMER
  INTERNAL
}

enum KbSource {
  MANUAL
  AUTO_POLICY
  AUTO_FACILITY
}

enum KbStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KbArticle {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  public_id   String     @unique @db.Char(26)
  /// fk: facilities.id SET NULL
  facility_id BigInt?    @db.UnsignedBigInt
  category    KbCategory
  audience    KbAudience @default(PUBLIC)
  locale      Locale     @default(vi)
  title       String     @db.VarChar(200)
  body        String     @db.Text
  source      KbSource   @default(MANUAL)
  status      KbStatus   @default(DRAFT)
  version     Int        @default(1) @db.UnsignedInt
  /// fk: users.id SET NULL
  updated_by  BigInt?    @db.UnsignedBigInt
  created_at  DateTime   @default(now()) @db.DateTime(3)
  updated_at  DateTime   @updatedAt @db.DateTime(3)
  chunks      KbChunk[]

  @@index([status, audience])
  @@map("kb_articles")
}

model KbChunk {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  article_id  BigInt     @db.UnsignedBigInt
  chunk_no    Int        @db.UnsignedSmallInt
  content     String     @db.Text
  audience    KbAudience
  facility_id BigInt?    @db.UnsignedBigInt
  vector_id   String?    @db.VarChar(64)
  article     KbArticle  @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@fulltext([content])
  @@map("kb_chunks")
}

model AssistantUsageDaily {
  usage_date         DateTime            @db.Date
  channel            ConversationChannel
  model              String              @db.VarChar(64)
  conversations      Int                 @default(0) @db.UnsignedInt
  messages           Int                 @default(0) @db.UnsignedInt
  input_tokens       Int                 @default(0) @db.UnsignedInt
  output_tokens      Int                 @default(0) @db.UnsignedInt
  estimated_cost_usd Decimal             @default(0) @db.Decimal(10, 4)
  fallback_count     Int                 @default(0) @db.UnsignedInt
  handoff_count      Int                 @default(0) @db.UnsignedInt

  @@id([usage_date, channel, model])
  @@map("assistant_usage_daily")
}

/// check: `contract_id` IS NOT NULL OR `reservation_id` IS NOT NULL
/// check: `total` = `subtotal` - `discount_total` + `tax_total`
model Invoice {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  public_id        String        @unique @db.Char(26)
  code             String        @unique @db.VarChar(32)
  customer_id      BigInt        @db.UnsignedBigInt
  facility_id      BigInt        @db.UnsignedBigInt
  contract_id      BigInt?       @db.UnsignedBigInt
  reservation_id   BigInt?       @db.UnsignedBigInt
  type             InvoiceType
  period_start     DateTime?     @db.Date
  period_end       DateTime?     @db.Date
  issue_date       DateTime      @db.Date
  due_date         DateTime      @db.Date
  status           InvoiceStatus @default(ISSUED)
  subtotal         Decimal       @db.Decimal(15, 2)
  discount_total   Decimal       @default(0) @db.Decimal(15, 2)
  tax_total        Decimal       @default(0) @db.Decimal(15, 2)
  total            Decimal       @db.Decimal(15, 2)
  amount_paid      Decimal       @default(0) @db.Decimal(15, 2)
  amount_credited  Decimal       @default(0) @db.Decimal(15, 2)
  /// generated: (`total` - `amount_paid` - `amount_credited`)
  balance_due      Decimal?      @db.Decimal(15, 2)
  currency         String        @default("VND") @db.Char(3)
  late_fee_applied Boolean       @default(false)
  dispute_hold     Boolean       @default(false)
  move_in_due      Boolean       @default(false)
  /// fk: media_files.id SET NULL
  pdf_media_id     BigInt?       @db.UnsignedBigInt
  paid_at          DateTime?     @db.DateTime(3)
  voided_at        DateTime?     @db.DateTime(3)
  void_reason      String?       @db.VarChar(255)
  version          Int           @default(0) @db.UnsignedInt
  created_at       DateTime      @default(now()) @db.DateTime(3)
  updated_at       DateTime      @updatedAt @db.DateTime(3)

  customer    Customer            @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  facility    Facility            @relation(fields: [facility_id], references: [id], onDelete: Restrict)
  contract    Contract?           @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  reservation Reservation?        @relation(fields: [reservation_id], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  allocations PaymentAllocation[]
  credit_notes CreditNote[]

  @@index([customer_id, status])
  @@index([contract_id, due_date])
  @@index([facility_id, status, due_date])
  @@index([issue_date])
  @@map("invoices")
}


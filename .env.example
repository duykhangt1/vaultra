# Vaultra Self-Storage Facility Rental & Management System — Root Environment Template
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# MySQL 8.0+ (UTF8MB4)
DATABASE_URL="mysql://root:@127.0.0.1:3306/vaultra"

# JWT RS256 / HS256 & Field Encryption (AES-256-GCM, 32-byte hex = 64 hex chars)
JWT_SECRET="dev-jwt-secret-change-in-production-must-be-at-least-32-chars"
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
INTERNAL_JOB_SECRET="dev-internal-job-secret-change-in-prod"

# Cloudflare Turnstile (optional in local dev)
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# Payment gateway: VNPay is the only one (sandbox: https://sandbox.vnpayment.vn/devreg/ — free,
# the TMN code and hash secret arrive by email). See README "Thanh toán VNPay (sandbox)".
PAYMENT_PROVIDER=VNPAY
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# Storage (local disk in dev, Cloudflare R2 in production)
STORAGE_DIR="./storage"
MEDIA_SIGNING_SECRET="dev-media-signing-secret"

# Email / SMTP (writes .eml to storage/mails/ when SMTP_HOST is empty or in non-production)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vaultra Storage <no-reply@vaultra.vn>"

# AI Assistant (deterministic tool-calling fallback when OPENAI_API_KEY is empty)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

